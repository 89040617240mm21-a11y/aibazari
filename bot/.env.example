# Copy to .env on the server and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# One or more Anthropic API keys, comma-separated; a key that runs out of credits is skipped until tomorrow
ANTHROPIC_API_KEYS=
# Daily AI budget = MONTHLY_BUDGET_USD / 30; over it -> cheap model only, over twice -> no AI
MONTHLY_BUDGET_USD=200
AI_LIMIT_DAY=50
AI_LIMIT_TRUSTED=100
AI_MODEL_CHEAP=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AIBAZARI_DB=/opt/aibazari/data/aibazari.db
DONATIONS_LEDGER=/opt/aibazari/data/donations.jsonl
